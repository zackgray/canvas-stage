{
 "clip": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "gemma4_e4b_it_fp8_scaled.safetensors",
   "type": "stable_diffusion",
   "device": "default"
  }
 },
 "sys": {
  "class_type": "PrimitiveStringMultiline",
  "inputs": {
   "value": "<system prompt>"
  }
 },
 "g_p0": {
  "class_type": "TextGenerate",
  "inputs": {
   "clip": [
    "clip",
    0
   ],
   "prompt": "<scene sentence>",
   "system_prompt": [
    "sys",
    0
   ],
   "max_length": 1100,
   "sampling_mode": "on",
   "sampling_mode.temperature": 0.5,
   "sampling_mode.top_k": 40,
   "sampling_mode.top_p": 0.95,
   "sampling_mode.min_p": 0.05,
   "sampling_mode.repetition_penalty": 1,
   "sampling_mode.seed": 13200,
   "thinking": false,
   "use_default_template": true
  }
 },
 "s_p0": {
  "class_type": "SaveText",
  "inputs": {
   "text": [
    "g_p0",
    0
   ],
   "filename_prefix": "canvas-stage/planner-p0",
   "format": "txt"
  }
 }
}
