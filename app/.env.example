# Copy to .env and restart the dev server after changing anything. Everything here is read by the app today.
# Setup order and a free check (npm run preflight): SETUP.md, Part B.

# Comfy Cloud (the supported path). Your key, server-side only.
COMFY_API_KEY=

# Spending guard: the most credits the app may spend per local day (about 2.11 credits per US cent). It is saved on disk
# and resets at local midnight. UNSET OR 0 = EVERY PAID PRESS IS REFUSED. Set 300: one scene taken to one rendered take is
# about 150 credits, so 300 leaves room for a retry. Restart the dev server after changing it.
CANVAS_DAY_BUDGET=

# Python for the local steps (clay video, hero-still colour match, Render finishing). It needs only OpenCV and numpy
# (pip install -r scripts/requirements.txt). Unset = the `python` on your PATH (on Windows often
# the Microsoft Store stub, which does not run: set the full path to your venv's python.exe).
# The finish needs only those; the massing clay adds trimesh, scipy,
# scikit-image (all in scripts/requirements.txt; `python scripts/check_python.py` lists what imports).
# (LIFT_PYTHON, the older name for this, still works.)
CANVAS_PYTHON=

# Render: the Layout-To-Render LoRA's name in your ComfyUI, if it is not the default
# (Lightricks__LTX-25-22b-IC-LoRA-Layout-To-Render__ltx-2.5-22b-ic-lora-layout-to-render-1.0.safetensors).
CANVAS_L2R_LORA=

# Self-hosted ComfyUI (untested, skip it; Cloud is the supported path). Leave both empty for Cloud.
# COMFY_BASE_URL: where the app sends jobs (a comfy-api-proxy in front of your ComfyUI, see scripts/README.md).
# COMFYUI_URL: your ComfyUI itself, e.g. http://127.0.0.1:8188, used to check graphs before spending
# (falls back to COMFY_BASE_URL when unset). With a self-signed certificate, NODE_USE_SYSTEM_CA=1 makes Node trust the OS store.
COMFY_BASE_URL=
COMFYUI_URL=

# Optional. CLAY_KEEP_FRAMES=1 keeps a take's raw clay frames for debugging; CLAY_YUNET is the full path to the YuNet
# face model if scripts/clay/models/ was moved.
CLAY_KEEP_FRAMES=
CLAY_YUNET=

# Motion box (optional): the always-on service that makes new moves from words (Shoot > Blocking > Describe a move).
# MOTION_BOX_URL: where the app sends a move, e.g. http://127.0.0.1:9650 — the near end of your SSH local port-forward
# to the box (ssh -L 9650:127.0.0.1:9650 <the motion box>, kept open while you work). Unset = new moves are off and the
# panel says so; the ready-made moves still work.
# MOTION_BOX_TOKEN: the shared secret the box checks on every call (the same value the box service was started with).
MOTION_BOX_URL=
MOTION_BOX_TOKEN=
